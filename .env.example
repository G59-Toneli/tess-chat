# Copie para .env na raiz: cp .env.example .env
# Lido por api/app/config.py (classe Settings). Nome da variável = campo em maiúsculas.

# --- Banco (obrigatório) ---
# Usuários e senhas de dev do docker-compose.yml e de docker/postgres-init/01-roles.sql. Não são segredo.
# A aplicação roda como tess_app (sem UPDATE/DELETE nas tabelas somente-inserção).
DATABASE_URL=postgresql+asyncpg://tess_app:tess_app@127.0.0.1:5433/tess
# Só o Alembic usa (migra e dá os GRANT/REVOKE).
DATABASE_URL_OWNER=postgresql+asyncpg://tess_owner:tess_owner@127.0.0.1:5433/tess

# --- Modelo (obrigatório para o chat responder) ---
# Gemini tier pago (ADR 0003). Sem ela, o chat não responde.
GEMINI_PAID_API_KEY=

# Ligação por voz (ADR 0026). Gemini Live; a chave free serve. Sem ela, a Ligação não abre.
GEMINI_LIVE_API_KEY=

# --- Opcionais: sem a chave, a feature degrada ---
# Tool web_search. Sem chave, a tool responde "indisponível".
TAVILY_API_KEY=
# Roteador Jev (ADR 0005). Sem chave, o Gemini decide a tool sozinho (AUTO).
TYPESAFE_API_KEY=

# --- Conector Google (ADR 0010). Passo a passo em docs/WIZARD-GOOGLE.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base do redirect do OAuth e da volta ao front. Produção: https://chat.toneli.dev.br
PUBLIC_BASE_URL=http://localhost:8000
# Chave Fernet dos tokens de Conector e do header de Servidor MCP. Sem ela, conectar responde 503.
# Gere com: cd api && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave depois invalida Conectores e Servidores MCP já cadastrados.
CONNECTORS_KEY=

# --- Ambiente ---
# produção: ENV=prod (fecha a exceção http do MCP demo)
ENV=dev

# --- Auth. Defaults de dev em config.py; troque em produção ---
# JWT_SECRET=dev-secret-trocar-em-producao-0123456789
# DEMO_PASSWORD=demo12345   (a conta demo nunca é admin)
# ADMIN_EMAIL=               (conta já cadastrada que o startup marca como admin)

# --- Ajustes com default em config.py ---
# ROTEADOR_LIMIAR=0.7
# CAP_USUARIO_MICRO_USD=2000000     (US$ 2)
# CAP_GLOBAL_MICRO_USD=20000000     (US$ 20)
# MAX_OUTPUT_TOKENS=8192
# COMPACTACAO_LIMIAR=100000
# COMPACTACAO_TURNOS_LITERAIS=2
# ATTACHMENTS_DIR=   (default: <raiz do repo>/data/attachments; use caminho absoluto)
# TOOL_CALLS_LIMIT=10
# GEMINI_LIVE_MODELO=gemini-3.8-live
# GEMINI_LIVE_VOZ=Kore
# LIGACAO_LIMITE_S=540      (a reserva de crédito cobre esse tempo)
# LIGACAO_TICKET_S=30
# LIGACAO_TETO_GLOBAL=3
# LIGACAO_FPS=1
# LIGACAO_RESOLUCAO=1280    (lado maior do Frame em px)

# --- Fora do app ---
# Servidor MCP de demo (serviço mcp-demo do compose). Vazio = sem autenticação.
# MCP_DEMO_TOKEN=
# O token do GitHub MCP não é lido do .env: o usuário cola na tela /mcp.
